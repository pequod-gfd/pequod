import glob
import os
import subprocess
import sys

path = os.path.dirname(__file__)
if len(sys.argv) > 1:
  tests = sys.argv[1:]
else:
  tests = glob.glob(os.path.join(path, "test_*"))

def TestNProcs(test):
  try:
    handle = open(test + ".F90", "r")
  except IOError:
    sys.stderr.write("WARNING: Test " + test + " source file not found\n")
    return 1
    
  nprocs = 1
  for line in handle.readlines():
    if line.startswith("!!NP") and len(line.split()) == 2:
      nprocs = int(line.split()[1])
  
  return nprocs

nPasses = 0
nFails = 0
fails = []
for test in tests:
  if not os.access(test, os.X_OK):
    sys.stderr.write("WARNING: Test " + test + " skipped - not executable\n")
    continue
    
  testName = os.path.basename(test)
  sys.stdout.write("Running test: " + str(testName) + " ... ")
  sys.stdout.flush()
  
  nprocs = TestNProcs(test)
  if "PETSC_OPTS" in os.environ:
    opts = " " + os.environ["PETSC_OPTS"]
  else:
    opts = ""
  if nprocs > 1:
    proc = subprocess.Popen((os.path.join(os.environ["MPI_DIR"], "bin", "mpirun") + " -np " + str(nprocs) + " " + os.path.join(os.path.curdir, test) + opts).split(), stdout = subprocess.PIPE)
  else:
    proc = subprocess.Popen((os.path.join(os.path.curdir, test) + opts).split(), stdout = subprocess.PIPE)
  proc.wait()
  output = proc.stdout.readlines()
  
  failLines = []
  if proc.returncode == 0:    
    print "COMPLETE"
  
    failed = False
    for line in output:
      sys.stdout.write(line)
      split = line.split()
      if len(split) > 0:
        if split[-1].lower() == "pass":
          nPasses += 1
        elif split[-1].lower() == "fail":
          failLines.append(line)
  else:
    print "ERROR"
    failLines = ["ERROR\n"]
  
  if len(failLines) > 0:
    fails.append((test, failLines))
    nFails += len(failLines)
       
print "==================="
print "=== Test output ==="
print "==================="
print "Passes: " + str(nPasses)
print "Fails:  " + str(nFails)
if len(fails) > 0:
  print "================"
  print "=== Failures ==="
  print "================"
  for test, failLines in fails:
    print test + ":"
    for line in failLines:
      sys.stdout.write(line)

if len(fails) > 0:
  sys.exit(-1)
