import glob
import os
import subprocess
import sys

path = os.path.dirname(__file__)
if len(sys.argv) > 1:
  tests = sys.argv[1:]
else:
  tests = glob.glob(os.path.join(path, "test_*"))

def TestNProcs(test):
  nprocs = 1
  try:
    with open(test + ".F90", "r") as handle:
      for line in handle:
        if line.startswith("!!NP") and len(line.split()) == 2:
          nprocs = int(line.split()[1])
  except OSError:
    sys.stderr.write("WARNING: Test " + test + " source file not found\n")
  return nprocs

mpi_dir = os.environ.get("MPI_DIR")
mpirun = os.path.join(mpi_dir, "bin", "mpirun") if mpi_dir else "mpirun"
opts = os.environ.get("PETSC_OPTS", "").split()

nPasses = 0
nFails = 0
fails = []
for test in tests:
  if not os.access(test, os.X_OK):
    sys.stderr.write("WARNING: Test " + test + " skipped - not executable\n")
    continue
    
  testName = os.path.basename(test)
  sys.stdout.write("Running test: " + str(testName) + " ... ")
  sys.stdout.flush()
  
  nprocs = TestNProcs(test)
  command = [mpirun, "-np", str(nprocs), os.path.abspath(test)] + opts
  proc = subprocess.run(command, stdout=subprocess.PIPE, text=True)

  failLines = []
  if proc.returncode == 0:
    print("COMPLETE")
    for line in proc.stdout.splitlines(keepends=True):
      sys.stdout.write(line)
      split = line.split()
      if len(split) > 0:
        if split[-1].lower() == "pass":
          nPasses += 1
        elif split[-1].lower() == "fail":
          failLines.append(line)
  else:
    print("ERROR")
    sys.stdout.write(proc.stdout)
    failLines = ["ERROR\n"]
  
  if len(failLines) > 0:
    fails.append((test, failLines))
    nFails += len(failLines)
       
print("===================")
print("=== Test output ===")
print("===================")
print("Passes: " + str(nPasses))
print("Fails:  " + str(nFails))
if len(fails) > 0:
  print("================")
  print("=== Failures ===")
  print("================")
  for test, failLines in fails:
    print(test + ":")
    for line in failLines:
      sys.stdout.write(line)

if len(fails) > 0:
  sys.exit(-1)
