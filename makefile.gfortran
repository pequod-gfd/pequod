FC = $(MPI_DIR)/bin/mpif90

INCLUDES = #-I$(PETSC_DIR)/$(PETSC_ARCH)/include -I$(PETSC_DIR)/include
LIBS = -llapack -lblas #-L$(PETSC_DIR)/$(PETSC_ARCH)/lib -lpetsc -lX11 -llapack -lblas 

DEBUG = -O0 -g -fbounds-check -finit-integer=-666 -finit-real=nan
FLAGS = -fdefault-real-8 -fdefault-double-8 -Wall -pipe -std=f2003
OPTIMISATION = -O3 -floop-interchange -floop-strip-mine -floop-block \
  -ftree-loop-distribution -funroll-loops -ffast-math \
  -march=native -mtune=native -fpack-derived
# The following has been observed to lead to memory errors on newton (x86_64)
# -frepack-arrays
LDOPTIMISATION = $(OPTIMISATION)

FCFLAGS = $(OPTIMISATION) $(FLAGS) -ffree-line-length-none -DNDEBUG $(DEFINES) $(INCLUDES)
#FCFLAGS = $(DEBUG) $(FLAGS) -ffree-line-length-none -DDDEBUG $(DEFINES) $(INCLUDES)

LD = $(FC)
LDFLAGS = $(LDOPTIMISATION)
