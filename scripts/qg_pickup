#!/usr/bin/env python
#
# James Maddison

"""
Copy data files for a QG pickup
"""

# Only standard Python modules here, for ease of use on clusters
import glob
import optparse
import os
import shutil
import sys

# User input
optionParser = optparse.OptionParser( \
  usage = "%prog [OPTIONS] DIR", \
  add_help_option = True, \
  description = "Copy data files for a QG pickup")
optionParser.add_option("-d", "--data", action = "store_false", dest = "config", help = "Copy only input data files, and not configuration files", default = True)
optionParser.add_option("-n", "--nproc", type = "int", dest = "nproc", help = "Specify the number of processes", default = None)
optionParser.add_option("-s", "--supplementary", action = "store_true", dest = "supp", help = "Require supplementary data files", default = False)
opts, args = optionParser.parse_args()

# The input directory
if len(args) == 0:
  sys.stderr.write("Input directory required\n")
  sys.exit(1)
elif len(args) == 2:
  sys.stderr.write("Unexpected trailing argument\n")
  sys.exit(1)
elif opts.nproc is None:
  sys.stderr.write("Number of processes required\n")
  sys.exit(1)
elif opts.nproc < 1:
  sys.stderr.write("Require more than zero processes\n")
  sys.exit(1)
inputDir = args[0]

def SerialHeaders(inputDir):
  """
  Return all serial header files.
  """
  
  files = glob.glob(os.path.join(inputDir, "qg*_*_s.*"))
  headers = []
  for file in files:
    split = os.path.basename(file).split("_")
    if not len(split) == 3:
      continue
    layers = split[0][2:]
    jj = split[1]
    dump = split[2][2:]
    if not layers.isdigit() or not jj.isdigit() or not dump.isdigit() \
       or layers.startswith("0") or jj.startswith("0") or (len(dump) > 1 and dump.startswith("0")):
      continue
    layers = int(layers)
    jj = int(jj)
    dump = int(dump)
    if not os.path.exists(os.path.join(inputDir, "qg%i_%i_s.d.%i" % (layers, jj, dump))):
      continue
    if opts.supp and (not os.path.exists(os.path.join(inputDir, "qg%i_%i_s_supp.%i" % (layers, jj, dump))) \
                   or not os.path.exists(os.path.join(inputDir, "qg%i_%i_s_supp.d.%i" % (layers, jj, dump)))):
      continue
    
    headers.append((file, layers, jj, dump))
  
  return headers  
  
def ParallelHeaders(inputDir):
  """
  Return all parallel header files associated with process zero.
  """
  
  files = glob.glob(os.path.join(inputDir, "qg*_*_s.*"))
  headers = []
  for file in files:
    split = os.path.basename(file).split("_")
    if not len(split) == 3:
      continue
    layers = split[0][2:]
    jj = split[1]
    split = split[2].split(".")
    if not len(split) == 3:
      continue
    dump = split[1]
    proc = split[2]
    if not layers.isdigit() or not jj.isdigit() or not dump.isdigit() or not proc.isdigit() \
       or layers.startswith("0") or jj.startswith("0") or (len(dump) > 1 and dump.startswith("0")) or (len(proc) > 1 and proc.startswith("0")):
      continue
    layers = int(layers)
    jj = int(jj)
    dump = int(dump)
    proc = int(proc)
    if not proc == 0:
      continue
    i = 0
    while os.path.exists(os.path.join(inputDir, "qg%i_%i_s.%i.%i" % (layers, jj, dump, i))) \
      and os.path.exists(os.path.join(inputDir, "qg%i_%i_s.%i.d.%i" % (layers, jj, dump, i))):
      i += 1
    if not i == opts.nproc:
      continue
    if opts.supp:
      if not os.path.exists(os.path.join(inputDir, "qg%i_%i_s_supp.%i.0" % (layers, jj, dump))):
        continue
      i = 0
      while os.path.exists(os.path.join(inputDir, "qg%i_%i_s_supp.%i.%i" % (layers, jj, dump, i))) \
        and os.path.exists(os.path.join(inputDir, "qg%i_%i_s_supp.%i.d.%i" % (layers, jj, dump, i))):
        i += 1
      if not i == opts.nproc:
        continue
    
    headers.append((file, layers, jj, dump))
  
  return headers

def CopyFile(src, dest):
  print "`%s' -> `%s'" % (src, dest)
  shutil.copyfile(src, dest)
  
  return
  
def CopyConfiguration(inputDir):
  """
  Copy configuration files, and switch configuration to pickup from input files.
  """
  
  CopyFile(os.path.join(inputDir, "config.h"), "config.h")
  CopyFile(os.path.join(inputDir, "qg3p_params.F90"), "qg3p_params.F90")
  
  handle = open("qg3p_params.F90", "r")
  config = handle.readlines()
  handle.close()
  
  handle = open("qg3p_params.F90", "w")
  foundStart = False
  for i, line in enumerate(config):
    strip = line.replace(" ", "").replace("\t", "").lower()
    if strip.startswith("integer,parameter::start="):
      line = "  integer, parameter :: start = START_PICKUP\n"
      handle.write(line)
      foundStart = True
      break
    handle.write(line)
  if not foundStart:
    sys.stderr.write("`start' parameter not found\n")
    sys.exit(1)
  for line in config[i + 1:]:
    handle.write(line)
  handle.close()
  
  return
  
def CopySerialData(inputDir, header):
  """
  Copy serial data.
  """
  
  headerFile     = "qg%i_%i_s" % (header[1], header[2])
  dataFile       = "qg%i_%i_s.d" % (header[1], header[2])
  suppHeaderFile = "qg%i_%i_s_supp" % (header[1], header[2])
  suppDataFile   = "qg%i_%i_s_supp.d" % (header[1], header[2])
  dumpTail       = ".%i" % header[3]

  print "Copying serial data for dump %i" % header[3]

  if opts.supp:
    print "Copying supplementary data file"
  
  if opts.config:
    CopyConfiguration(inputDir)
  if not os.path.isdir("input"):
    os.mkdir("input")
  CopyFile(os.path.join(inputDir, "stratification"), os.path.join("input", "stratification"))
  if len(glob.glob(os.path.join(inputDir, "u"))) == 1:
    CopyFile(os.path.join(inputDir, "u"), os.path.join("input", "u"))
  CopyFile(os.path.join(inputDir, headerFile + dumpTail), os.path.join("input", headerFile))
  CopyFile(os.path.join(inputDir, dataFile + dumpTail), os.path.join("input", dataFile))
  
  if opts.supp:
    CopyFile(os.path.join(inputDir, suppHeaderFile + dumpTail), os.path.join("input", suppHeaderFile))
    CopyFile(os.path.join(inputDir, suppDataFile + dumpTail), os.path.join("input", suppDataFile))
    
  handle = open("input.txt", "w")
  handle.write(os.path.abspath(inputDir) + "\n")
  handle.close()

  return
  
def CopyParallelData(inputDir, header):
  """
  Copy parallel data.
  """
  
  headerFile     = "qg%i_%i_s" % (header[1], header[2])
  suppHeaderFile = "qg%i_%i_s_supp" % (header[1], header[2])
  dumpTail       = ".%i" % header[3]
  
  files = glob.glob(os.path.join(inputDir, headerFile + dumpTail + ".*"))
  n = 0
  for file in files:
    split = os.path.basename(file).split(".")
    if not len(split) == 3:
      continue
    if not split[2].isdigit() or (len(split[2]) > 1 and split[2].startswith("0")):
      continue
    n = max(n, int(split[2]) + 1)
  assert(n > 0)
  print "Copying parallel data for dump %i with %i processes" % (header[3], n)
  
  if opts.supp:
    print "Copying supplementary data files"
  
  if opts.config:
    CopyConfiguration(inputDir)
  if not os.path.isdir("input"):
    os.mkdir("input")
  CopyFile(os.path.join(inputDir, "stratification"), os.path.join("input", "stratification"))
  if len(glob.glob(os.path.join(inputDir, "u"))) == 1:
    CopyFile(os.path.join(inputDir, "u"), os.path.join("input", "u"))
  for p in range(n):
    procTail = ".%i" % p
  
    CopyFile(os.path.join(inputDir, headerFile + dumpTail + procTail), os.path.join("input", headerFile + procTail))
    CopyFile(os.path.join(inputDir, headerFile + dumpTail + ".d" + procTail), os.path.join("input", headerFile + ".d" + procTail))
    
    if opts.supp:
      CopyFile(os.path.join(inputDir, suppHeaderFile + dumpTail + procTail), os.path.join("input", suppHeaderFile + procTail))
      CopyFile(os.path.join(inputDir, suppHeaderFile + dumpTail + ".d" + procTail), os.path.join("input", suppHeaderFile + ".d" + procTail))
    
  handle = open("input.txt", "w")
  handle.write(os.path.abspath(inputDir) + "\n")
  handle.close()
      
  return

if opts.nproc == 1:
  headers = SerialHeaders(inputDir)
else:
  headers = ParallelHeaders(inputDir)

if len(headers) == 0:
  sys.stderr.write("No data files found\n")
  sys.exit(1)

layers = headers[0][1]
jj = headers[0][2]
dump = headers[0][3]
index = 0
for i, header in enumerate(headers[1:]):
  if not header[1] == layers or not header[2] == jj:
    sys.stderr.write("Multiple dimension data files found\n")
    sys.exit(1)
  if header[3] > dump:
    dump = header[3]
    index = i + 1
     
if opts.nproc == 1:
  CopySerialData(inputDir, headers[index])
else:
  CopyParallelData(inputDir, headers[index])
