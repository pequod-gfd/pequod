FC = ftn

INCLUDES = #-I$(PETSC_DIR)/$(PETSC_ARCH)/include -I$(PETSC_DIR)/include
LIBS = -lsci_cray #-L$(PETSC_DIR)/$(PETSC_ARCH)/lib -lcraypetsc

DEBUG = -O0 -g -R bcps
FLAGS = -s real64 -m 3 -N 255
OPTIMISATION = -O3
LDOPTIMISATION = $(OPTIMISATION)

FCFLAGS = $(OPTIMISATION) $(FLAGS) -DNDEBUG $(DEFINES) $(INCLUDES)
#FCFLAGS = $(DEBUG) $(FLAGS) -DDDEBUG $(DEFINES) $(INCLUDES)

LD = $(FC)
LDFLAGS = $(LDOPTIMISATION)
